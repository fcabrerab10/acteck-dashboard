{
  "crons": [
    {
      "path": "/api/cron?task=sync-master-embarques",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron?task=actualizar-fill-rates",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron?task=recordatorio-eval",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron?task=recordatorio-tracking",
      "schedule": "0 15 * * 1-5"
    },
    {
      "path": "/api/cron?task=forecast-avisos",
      "schedule": "30 14 * * *"
    }
  ],
  "headers": [
    {
      "source": "/uploads.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/registerSW.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    }
  ]
}
