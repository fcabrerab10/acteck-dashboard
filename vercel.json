{
  "crons": [
    {
      "path": "/api/cron?task=actualizar-fill-rates",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron?task=recordatorio-eval",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron?task=recordatorio-tracking",
      "schedule": "0 15 * * 1-5"
    },
    {
      "path": "/api/cron?task=forecast-avisos",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/cron?task=generar-alertas",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron?task=resumen-programado",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron?task=resumen-programado",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron?task=resumen-programado",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron?task=agenda-hoy",
      "schedule": "30 14 * * 1-6"
    },
    {
      "path": "/api/cron?task=pagos-calcular",
      "schedule": "0 14 2 * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/admin/:accion",
      "destination": "/api/admin?accion=:accion"
    }
  ],
  "headers": [
    {
      "source": "/uploads.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/registerSW.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ]
}
