# ── Puente de sincronización · credenciales ──────────────────────────────────
# Este archivo se copia solo a `credenciales.env` al correr setup.sh (o npm ci).
# Llena `credenciales.env`; nunca se sube al repo (está en .gitignore).

# ── Destino · Supabase DIRECTO (recomendado) ───────────────────────────────
# Con el service role key el puente escribe directo por PostgREST (upsert,
# replace, refresh de facturacion_clientes y MVs) sin pasar por Vercel.
# Es el mismo key de .env.local de la laptop. chmod 600 a este archivo.
SUPABASE_URL=https://hrhccvuhnedahznewgaj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Destino · respaldo vía Vercel (sólo si NO hay service role key) ────────
# Pasa por /api/import-central con SYNC_SECRET (misma env var en Vercel).
DASHBOARD_URL=https://acteck-dashboard.vercel.app
SYNC_SECRET=

# ── SQL Server · Ventas / Inventario / Precios (ERP) ───────────────────────
ERP_SQL_HOST=192.168.0.151
ERP_SQL_PORT=1433
ERP_SQL_DB=
ERP_SQL_USER=
ERP_SQL_PASS=
# Vistas (nombre con esquema si aplica, ej. dbo.Vw_TablaH_Ventas)
ERP_VIEW_VENTAS=Vw_TablaH_Ventas
ERP_VIEW_INVENTARIO=Vw_TablaH_Inventario
ERP_VIEW_PRECIOS=Vw_TablaM_Precios
# Opcional: POs de compras (Vw_TablaH_Compras → compras_oc). Vacío = no se sincroniza.
ERP_VIEW_COMPRAS=
# Ventas: por default cada corrida trae sólo los últimos ERP_VENTAS_DIAS días (por
# `periodo`) y reemplaza esa ventana en Supabase; después recalcula facturacion_clientes.
# Para una carga completa de un año (inicial o histórico): ./run.sh ventas --anios 2025,2026
# o pon los años aquí (vacío = modo ventana).
ERP_VENTAS_DIAS=45
ERP_VENTAS_ANIOS=

# ── SQL Server · Cuotas ────────────────────────────────────────────────────
CUOTAS_SQL_HOST=192.168.0.213
CUOTAS_SQL_PORT=1433
CUOTAS_SQL_DB=RevkoBi
CUOTAS_SQL_USER=
CUOTAS_SQL_PASS=
CUOTAS_VIEW=dbo.BP
# Columnas de dbo.BP en orden: número de cliente (5 dígitos, CT = 00183), nombre,
# fecha, cuota mínima (mide vendedores → cuota_min), cuota vendor (mide apoyos
# del cliente → cuota_ideal, la meta del dashboard), unidades (→ cuota_piezas) y
# costo de venta (→ cuota_costo). Se SUMAN por cliente y mes.
# Las dos últimas son opcionales: si se quitan, cuota_piezas y cuota_costo quedan
# NULL (en pantalla "—") y [Cuota Contribucion] / [% Alcance Piezas] no se calculan.
CUOTAS_COLS=IDCLIENTE,NOMBRECLIENTE,FECHA,CUOTAMINIMA,IMPORTEDEVENTA,UNIDADES,COSTODEVENTA

# ── SQL Server · Sell Out General (mayoristas) ─────────────────────────────
SELLOUT_SQL_HOST=192.168.0.160
SELLOUT_SQL_PORT=1433
SELLOUT_SQL_DB=SELLOUT
SELLOUT_SQL_USER=
SELLOUT_SQL_PASS=
# Vista dentro de la base SELLOUT (se llama "sell out", con espacio).
SELLOUT_VIEW=dbo.sell out
# Columna fecha de la vista y ventana incremental (días hacia atrás). Upsert por id.
SELLOUT_FECHA_COL=fecha
SELLOUT_SINCE_DAYS=45

# ── Google Sheets · Master Embarques ───────────────────────────────────────
# ID del documento (lo que va entre /d/ y /edit en la URL).
MASTER_EMBARQUES_SHEET_ID=1m2I_oTd4EYTQ1v5KQOAZGIPmt58K3jRUbHGk0ed0JoQ
# Opción A (recomendada): service account de Google Cloud con la hoja
# compartida como "Lector" al correo del service account. Ruta al JSON.
GOOGLE_SERVICE_ACCOUNT_FILE=./google-sa.json
# Opción B: sin service account. Requiere que la hoja esté compartida como
# "Cualquier persona con el enlace · Lector" (se usa la exportación CSV).

# Cifrado TLS hacia SQL Server. On-prem sin certificado válido: encrypt=false.
SQL_ENCRYPT=false
SQL_TRUST_CERT=true
