# Copia a .env.local y rellena. NUNCA commitear .env.local.

# Supabase (cliente)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase (servidor · /api/*)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# Cron / puente de sincronización
CRON_SECRET=
SYNC_SECRET=

# Avatares ilustrados (api/avatar.js). Sin IMAGE_API_KEY el endpoint usa el fallback local
# (selfie en círculo sobre public/avatares/fondo-*.svg, compuesto en el navegador).
# IMAGE_PROVIDER: 'openai' (por defecto, gpt-image-1 images/edits). Otros proveedores: ver PROVEEDORES en api/avatar.js.
IMAGE_API_KEY=
IMAGE_PROVIDER=openai
